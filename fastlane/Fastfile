# Store automation, run from GitHub Actions (.github/workflows/mobile-release.yml).
# Credentials come from environment variables set from GitHub Secrets — see STORE.md.

default_platform(:ios)

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8"),
    is_key_content_base64: false,
  )
end

platform :ios do
  desc "Build a signed release and upload it to TestFlight"
  lane :beta do
    setup_ci
    api_key = asc_api_key
    key_path = File.expand_path("../ios-asc-key.p8", __dir__)
    File.write(key_path, ENV.fetch("ASC_KEY_P8"))

    build_number = ENV.fetch("BUILD_NUMBER", "1")
    increment_build_number(xcodeproj: "ios/App/App.xcodeproj", build_number: build_number)
    if ENV["VERSION_NAME"]
      increment_version_number(xcodeproj: "ios/App/App.xcodeproj", version_number: ENV["VERSION_NAME"])
    end

    # Xcode cloud-managed signing with the App Store Connect API key:
    # no certificates or profiles to store in the repo or in secrets.
    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      export_method: "app-store",
      output_directory: "build/ios",
      xcargs: [
        "-allowProvisioningUpdates",
        "-authenticationKeyPath #{key_path}",
        "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')}",
        "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
        "DEVELOPMENT_TEAM=#{ENV.fetch('APPLE_TEAM_ID')}",
        "CODE_SIGN_STYLE=Automatic",
      ].join(" "),
      export_options: { signingStyle: "automatic", teamID: ENV.fetch("APPLE_TEAM_ID") },
      export_xcargs: "-allowProvisioningUpdates -authenticationKeyPath #{key_path} " \
                     "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} " \
                     "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
    )
    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end

  desc "Upload App Store texts and screenshots (does not submit for review)"
  lane :metadata do
    deliver(
      api_key: asc_api_key,
      skip_binary_upload: true,
      overwrite_screenshots: true,
      submit_for_review: false,
      force: true,
      precheck_include_in_app_purchases: false,
      app_review_information: {
        notes: File.read(File.expand_path("metadata/review_information/notes.txt", __dir__)),
      },
    )
  end
end

platform :android do
  desc "Upload the signed AAB to a Play track (default: closed testing 'alpha')"
  lane :upload do
    upload_to_play_store(
      track: ENV.fetch("PLAY_TRACK", "alpha"),
      aab: ENV.fetch("AAB_PATH"),
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      metadata_path: "fastlane/metadata/android",
      skip_upload_metadata: true,
      skip_upload_images: true,
      skip_upload_screenshots: true,
      release_status: ENV.fetch("PLAY_RELEASE_STATUS", "completed"),
    )
  end

  desc "Upload Play Store texts and images"
  lane :metadata do
    upload_to_play_store(
      json_key_data: ENV.fetch("PLAY_SERVICE_ACCOUNT_JSON"),
      metadata_path: "fastlane/metadata/android",
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_changelogs: true,
    )
  end
end
