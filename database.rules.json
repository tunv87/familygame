{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (data.child('players').child(auth.uid).exists() || ((!data.exists() || data.child('createdAt').val() < now - 86400000) && newData.child('hostUid').val() === auth.uid))",
        ".validate": "$code.matches(/^[0-9]{4}$/) && (!newData.exists() || newData.hasChildren(['game', 'hostUid', 'createdAt', 'status']))",
        "game": {
          ".validate": "newData.val() === 'numbers' || newData.val() === 'caro'"
        },
        "status": {
          ".validate": "newData.val() === 'waiting' || newData.val() === 'playing'"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "hostUid": {
          ".validate": "!data.exists() || data.val() === newData.val() || data.parent().child('createdAt').val() < now - 86400000"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().exists() && (data.parent().parent().child('hostUid').val() === $uid || newData.parent().parent().child('guestUid').val() === $uid)",
            ".validate": "!newData.exists() || newData.hasChildren(['name', 'avatar'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
            },
            "avatar": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            }
          }
        },
        "guestUid": {
          ".write": "auth != null && newData.val() === auth.uid && !data.exists() && data.parent().exists()",
          ".validate": "newData.isString()"
        }
      }
    }
  }
}
