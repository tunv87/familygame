{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (((!data.exists() || data.child('createdAt').val() < now - 86400000) && newData.child('hostUid').val() === auth.uid) || (root.child('rooms').child($code).child('players').child(auth.uid).exists() && !newData.exists()))",
        ".validate": "$code.matches(/^[0-9]{4}$/) && (!newData.exists() || newData.hasChildren(['game', 'hostUid', 'createdAt', 'status']))",
        "code": {
          ".validate": "newData.val() === $code"
        },
        "game": {
          ".validate": "newData.val() === 'numbers' || newData.val() === 'caro' || newData.val() === 'coganh' || newData.val() === 'oanquan' || newData.val() === 'noitu' || newData.val() === 'cangua'"
        },
        "options": {
          ".validate": "newData.hasChildren()"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 60000"
        },
        "hostUid": {
          ".validate": "newData.isString()"
        },
        "status": {
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()",
          ".validate": "newData.val() === 'waiting' || newData.val() === 'playing'"
        },
        "round": {
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()",
          ".validate": "newData.isNumber()"
        },
        "state": {
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()"
        },
        "results": {
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists()"
        },
        "rematch": {
          ".write": "auth != null && root.child('rooms').child($code).child('players').child(auth.uid).exists() && !newData.exists()",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($code).child('players').child(auth.uid).exists()",
            ".validate": "newData.isBoolean()"
          }
        },
        "guestUid": {
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid && data.parent().exists()) || (data.val() === auth.uid && !newData.exists()))",
          ".validate": "newData.isString()"
        },
        "seat3": {
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid && data.parent().exists() && data.parent().child('game').val() === 'cangua' && data.parent().child('status').val() === 'waiting' && data.parent().child('guestUid').exists() && data.parent().child('guestUid').val() !== auth.uid) || (data.val() === auth.uid && !newData.exists()))",
          ".validate": "newData.isString()"
        },
        "seat4": {
          ".write": "auth != null && ((!data.exists() && newData.val() === auth.uid && data.parent().exists() && data.parent().child('game').val() === 'cangua' && data.parent().child('status').val() === 'waiting' && data.parent().child('seat3').exists() && data.parent().child('seat3').val() !== auth.uid && data.parent().child('guestUid').val() !== auth.uid) || (data.val() === auth.uid && !newData.exists()))",
          ".validate": "newData.isString()"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().exists() && (data.parent().parent().child('hostUid').val() === $uid || newData.parent().parent().child('guestUid').val() === $uid || newData.parent().parent().child('seat3').val() === $uid || newData.parent().parent().child('seat4').val() === $uid || (data.exists() && !newData.exists()))",
            ".validate": "!newData.exists() || newData.hasChildren(['name', 'avatar'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 20"
            },
            "avatar": {
              ".validate": "newData.isString() && newData.val().length <= 16"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "joinedAt": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "config": {
      ".read": true
    },
    "stats": {
      "plays": {
        ".read": true,
        "$game": {
          ".write": "auth != null && newData.exists()",
          ".validate": "($game === 'numbers' || $game === 'caro' || $game === 'coganh' || $game === 'oanquan' || $game === 'noitu' || $game === 'cangua') && newData.isNumber() && newData.val() === (data.exists() ? data.val() : 0) + 1"
        }
      }
    },
    "suggestions": {
      "$id": {
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.hasChildren(['word', 'at'])",
        "word": {
          ".validate": "newData.isString() && newData.val().length <= 30 && newData.val().matches(/^[^ ]+ [^ ]+$/)"
        },
        "at": {
          ".validate": "newData.val() === now"
        },
        "$other": {
          ".validate": false
        }
      }
    }
  }
}
